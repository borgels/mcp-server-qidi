QIDI_MOONRAKER_URL=http://printer.lan:7125
# QIDI_SNAPSHOT_URL=http://printer.lan/webcam/?action=snapshot
QIDI_ENABLE_CONTROL=false
QIDI_ENABLE_PRINT_START=false
# Integers; an invalid value stops the server.
# QIDI_MAX_NOZZLE_TEMP=300
# QIDI_MAX_BED_TEMP=110
# QIDI_MAX_CHAMBER_TEMP=65
# QIDI_PLATE_CHECK_MAX_AGE_MIN=15
# QIDI_AUDIT_LOG=/data/audit.jsonl
# QIDI_TRUST_FORWARDED_USER=true   # only behind an authenticating gateway, with MCP_HTTP_TOKEN
# QIDI_MOONRAKER_API_KEY=
# QIDI_TIMEOUT_MS=10000

# Streamable HTTP transport
MCP_HTTP_HOST=127.0.0.1
PORT=3000
# Required (>= 32 printable ASCII characters, e.g. `openssl rand -hex 32`) on a
# non-loopback bind, with MCP_ALLOW_ANY_ORIGIN=true or QIDI_TRUST_FORWARDED_USER=true.
# MCP_HTTP_TOKEN=
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
# MCP_MAX_BODY_BYTES=10485760
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_ALLOWED_HOSTS=
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
